<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_UPPTech" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:message id="Message_UpitPonuda" name="Upit za ponudu" />
  <bpmn:message id="Message_Ponuda" name="Ponuda" />
  <bpmn:message id="Message_PotvrdaPonude" name="Potvrda o prihvaćanju ponude" />
  <bpmn:message id="Message_Softver" name="Softver za implementaciju" />
  <bpmn:collaboration id="Collaboration_UPPTech">
    <bpmn:participant id="Participant_UPPTech" name="UPPTech" processRef="Process_UPPTech" />
    <bpmn:participant id="Participant_CrazyTech_Ponuda" name="CrazyTech – ponuda" processRef="Process_CrazyTechPonuda" />
    <bpmn:participant id="Participant_CrazyTech_Razvoj" name="CrazyTech – razvoj softvera" processRef="Process_CrazyTechRazvoj" />
    <bpmn:messageFlow id="MF_Upit" name="Upit" sourceRef="Task_PoslatiUpit" targetRef="Start_Upit" />
    <bpmn:messageFlow id="MF_Ponuda" name="Ponuda" sourceRef="Task_DostavitiPonudu" targetRef="Task_ZaprimitiPonudu" />
    <bpmn:messageFlow id="MF_Potvrda" name="Potvrda" sourceRef="Task_PoslatiPotvrdu" targetRef="Start_Potvrda" />
    <bpmn:messageFlow id="MF_Softver" name="Softver" sourceRef="Task_PredatiSoftver" targetRef="Task_ZaprimitiSoftver" />
  </bpmn:collaboration>
  <bpmn:process id="Process_UPPTech" name="Implementacija softvera u tvrtki UPPTech" isExecutable="false">
    <bpmn:documentation>Proces od ustanovljene potrebe do implementacije softvera. Management donosi poslovne odluke, IT tim provodi tehničke provjere, instalaciju i implementaciju.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_UPPTech">
      <bpmn:lane id="Lane_IT" name="IT tim">
        <bpmn:flowNodeRef>Task_ProvjeritiSoftvere</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostojiRjesenje</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Instalirati</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KupljeniSoftver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Outsourcing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PoslatiUpit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZaprimitiSoftver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Implementirati</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SoftverImplementiran</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Management" name="Management tim">
        <bpmn:flowNodeRef>Start_Potreba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefiniratiPotrebe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DogovoritiKupnju</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZaprimitiPonudu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RazmotritiPonudu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PoslatiPotvrdu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PonudaOdbijena</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PonudaPrihvacena</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Potreba" name="Potreba za novim softverom ustanovljena" />
    <bpmn:userTask id="Task_DefiniratiPotrebe" name="Definirati poslovne potrebe i zahtjeve" />
    <bpmn:userTask id="Task_ProvjeritiSoftvere" name="Provjeriti dostupne softvere na tržištu" />
    <bpmn:exclusiveGateway id="Gateway_PostojiRjesenje" name="Postoji odgovarajuće rješenje?" />
    <bpmn:userTask id="Task_DogovoritiKupnju" name="Dogovoriti kupnju softvera" />
    <bpmn:serviceTask id="Task_Instalirati" name="Instalirati softver na server" />
    <bpmn:endEvent id="End_KupljeniSoftver" name="Softver kupljen i instaliran" />
    <bpmn:userTask id="Task_Outsourcing" name="Odlučiti o outsourcingu razvoja" />
    <bpmn:sendTask id="Task_PoslatiUpit" name="Poslati upit za ponudu tvrtki CrazyTech" messageRef="Message_UpitPonuda" />
    <bpmn:receiveTask id="Task_ZaprimitiPonudu" name="Zaprimiti ponudu" messageRef="Message_Ponuda" />
    <bpmn:userTask id="Task_RazmotritiPonudu" name="Razmotriti ponudu">
      <bpmn:documentation>Management razmatra ponudu CrazyTecha i odlučuje hoće li je prihvatiti. Ako je odbije, proces završava.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_PoslatiPotvrdu" name="Poslati potvrdu o prihvaćanju ponude" messageRef="Message_PotvrdaPonude" />
    <bpmn:endEvent id="End_PonudaOdbijena" name="Ponuda odbijena – proces završen" />
    <bpmn:receiveTask id="Task_ZaprimitiSoftver" name="Zaprimiti softver za implementaciju" messageRef="Message_Softver">
      <bpmn:documentation>IT tim zaprima softver od CrazyTecha i implementira ga na server tvrtke UPPTech.</bpmn:documentation>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Task_Implementirati" name="Implementirati softver na server" />
    <bpmn:endEvent id="End_SoftverImplementiran" name="Softver implementiran" />
    <bpmn:exclusiveGateway id="Gateway_PonudaPrihvacena" name="Ponuda prihvaćena?" />
    <bpmn:sequenceFlow id="F_P1" sourceRef="Start_Potreba" targetRef="Task_DefiniratiPotrebe" />
    <bpmn:sequenceFlow id="F_P2" sourceRef="Task_DefiniratiPotrebe" targetRef="Task_ProvjeritiSoftvere" />
    <bpmn:sequenceFlow id="F_P3" sourceRef="Task_ProvjeritiSoftvere" targetRef="Gateway_PostojiRjesenje" />
    <bpmn:sequenceFlow id="F_P4" name="Da" sourceRef="Gateway_PostojiRjesenje" targetRef="Task_DogovoritiKupnju" />
    <bpmn:sequenceFlow id="F_P7" name="Ne" sourceRef="Gateway_PostojiRjesenje" targetRef="Task_Outsourcing" />
    <bpmn:sequenceFlow id="F_P5" sourceRef="Task_DogovoritiKupnju" targetRef="Task_Instalirati" />
    <bpmn:sequenceFlow id="F_P6" sourceRef="Task_Instalirati" targetRef="End_KupljeniSoftver" />
    <bpmn:sequenceFlow id="F_P8" sourceRef="Task_Outsourcing" targetRef="Task_PoslatiUpit" />
    <bpmn:sequenceFlow id="F_P8b" sourceRef="Task_PoslatiUpit" targetRef="Task_ZaprimitiPonudu" />
    <bpmn:sequenceFlow id="F_P9" sourceRef="Task_ZaprimitiPonudu" targetRef="Task_RazmotritiPonudu" />
    <bpmn:sequenceFlow id="F_P10" sourceRef="Task_RazmotritiPonudu" targetRef="Gateway_PonudaPrihvacena" />
    <bpmn:sequenceFlow id="F_P11" name="Da" sourceRef="Gateway_PonudaPrihvacena" targetRef="Task_PoslatiPotvrdu" />
    <bpmn:sequenceFlow id="F_P13" sourceRef="Task_PoslatiPotvrdu" targetRef="Task_ZaprimitiSoftver" />
    <bpmn:sequenceFlow id="F_P12" name="Ne" sourceRef="Gateway_PonudaPrihvacena" targetRef="End_PonudaOdbijena" />
    <bpmn:sequenceFlow id="F_P14" sourceRef="Task_ZaprimitiSoftver" targetRef="Task_Implementirati" />
    <bpmn:sequenceFlow id="F_P15" sourceRef="Task_Implementirati" targetRef="End_SoftverImplementiran" />
  </bpmn:process>
  <bpmn:process id="Process_CrazyTechPonuda" name="CrazyTech – izrada ponude" isExecutable="false">
    <bpmn:documentation>Vanjski proces procjene troškova i dostave ponude.</bpmn:documentation>
    <bpmn:startEvent id="Start_Upit" name="Upit za ponudu zaprimljen">
      <bpmn:messageEventDefinition id="MsgDef_Message_UpitPonuda" messageRef="Message_UpitPonuda" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ProcijenitiTrosak" name="Procijeniti troškove razvoja" />
    <bpmn:sendTask id="Task_DostavitiPonudu" name="Dostaviti ponudu UPPTechu" messageRef="Message_Ponuda" />
    <bpmn:endEvent id="End_PonudaDostavljena" name="Ponuda dostavljena" />
    <bpmn:sequenceFlow id="F_O1" sourceRef="Start_Upit" targetRef="Task_ProcijenitiTrosak" />
    <bpmn:sequenceFlow id="F_O2" sourceRef="Task_ProcijenitiTrosak" targetRef="Task_DostavitiPonudu" />
    <bpmn:sequenceFlow id="F_O3" sourceRef="Task_DostavitiPonudu" targetRef="End_PonudaDostavljena" />
  </bpmn:process>
  <bpmn:process id="Process_CrazyTechRazvoj" name="CrazyTech – razvoj softverskog rješenja" isExecutable="false">
    <bpmn:documentation>Vanjski proces razvoja softvera nakon prihvaćanja ponude. Sadrži potproces razvoja s povratnom petljom na fazu razvoja ako testiranje ne prođe.</bpmn:documentation>
    <bpmn:startEvent id="Start_Potvrda" name="Potvrda zaprimljena">
      <bpmn:messageEventDefinition id="MsgDef_Message_PotvrdaPonude" messageRef="Message_PotvrdaPonude" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Razvoj" name="Razviti softversko rješenje">
      <bpmn:documentation>Složeni proces razvoja: definiranje zahtjeva, dizajn, razvoj i testiranje. Ako testiranje ne prođe, postupak se vraća na fazu razvoja.</bpmn:documentation>
      <bpmn:startEvent id="SubStart_Razvoj" name="Početak razvoja" />
      <bpmn:userTask id="SubTask_Zahtjevi" name="Definirati zahtjeve" />
      <bpmn:userTask id="SubTask_Dizajn" name="Dizajnirati softver" />
      <bpmn:exclusiveGateway id="SubGateway_Nastaviti" name="Nastaviti razvoj?" />
      <bpmn:userTask id="SubTask_Razviti" name="Razviti softver" />
      <bpmn:userTask id="SubTask_Testirati" name="Testirati softver" />
      <bpmn:exclusiveGateway id="SubGateway_Test" name="Testiranje uspješno?" />
      <bpmn:endEvent id="SubEnd_Razvoj" name="Razvoj uspješno dovršen" />
      <bpmn:sequenceFlow id="SF1" sourceRef="SubStart_Razvoj" targetRef="SubTask_Zahtjevi" />
      <bpmn:sequenceFlow id="SF2" sourceRef="SubTask_Zahtjevi" targetRef="SubTask_Dizajn" />
      <bpmn:sequenceFlow id="SF3" sourceRef="SubTask_Dizajn" targetRef="SubGateway_Nastaviti" />
      <bpmn:sequenceFlow id="SF4" sourceRef="SubGateway_Nastaviti" targetRef="SubTask_Razviti" />
      <bpmn:sequenceFlow id="SF5" sourceRef="SubTask_Razviti" targetRef="SubTask_Testirati" />
      <bpmn:sequenceFlow id="SF6" sourceRef="SubTask_Testirati" targetRef="SubGateway_Test" />
      <bpmn:sequenceFlow id="SF7" name="Da" sourceRef="SubGateway_Test" targetRef="SubEnd_Razvoj" />
      <bpmn:sequenceFlow id="SF8" name="Ne – ispravci" sourceRef="SubGateway_Test" targetRef="SubGateway_Nastaviti" />
    </bpmn:subProcess>
    <bpmn:sendTask id="Task_PredatiSoftver" name="Predati softver UPPTechu" messageRef="Message_Softver" />
    <bpmn:endEvent id="End_RazvojDovrsen" name="Razvoj dovršen" />
    <bpmn:sequenceFlow id="F_D1" sourceRef="Start_Potvrda" targetRef="Sub_Razvoj" />
    <bpmn:sequenceFlow id="F_D2" sourceRef="Sub_Razvoj" targetRef="Task_PredatiSoftver" />
    <bpmn:sequenceFlow id="F_D3" sourceRef="Task_PredatiSoftver" targetRef="End_RazvojDovrsen" />
  </bpmn:process>
