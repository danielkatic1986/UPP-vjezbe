<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Upis" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:message id="Message_RangListe" name="Rang-liste kandidata" />
  <bpmn:message id="Message_ZahtjevDorada" name="Zahtjev za doradu dokumentacije" />
  <bpmn:message id="Message_IspravljenaDok" name="Ispravljena dokumentacija" />
  <bpmn:message id="Message_ObavijestKandidati" name="Obavijest kandidatima" />
  <bpmn:message id="Message_DokumentacijaEmail" name="Dokumentacija e-poštom" />
  <bpmn:collaboration id="Collaboration_Upis">
    <bpmn:participant id="Participant_NISpVU" name="NISpVU – Postani student (obrada prijava)" processRef="Process_NISpVU" />
    <bpmn:participant id="Participant_NISpVU_Dorada" name="NISpVU – dorada dokumentacije (vanjski sustav)" />
    <bpmn:participant id="Participant_Sveuciliste" name="Sveučilište Jurja Dobrile u Puli" processRef="Process_Upis" />
    <bpmn:participant id="Participant_Kandidati" name="Kandidati / studenti (vanjski sudionici)" />
    <bpmn:messageFlow id="MF_RangListe" name="Rang-liste" sourceRef="Task_DostavitiRang" targetRef="Start_RangListe" />
    <bpmn:messageFlow id="MF_ZahtjevDorada" name="Zahtjev za doradu" sourceRef="Task_ProvjeritiDorada" targetRef="Participant_NISpVU_Dorada" />
    <bpmn:messageFlow id="MF_Ispravljena" name="Ispravljena dokumentacija" sourceRef="Participant_NISpVU_Dorada" targetRef="Task_ZaprimitiIspravljenu" />
    <bpmn:messageFlow id="MF_ObavijestKandidati" name="Obavijest kandidatima" sourceRef="Task_ObavijestitiKandidate" targetRef="Participant_Kandidati" />
    <bpmn:messageFlow id="MF_DokumentacijaEmail" name="Dokumentacija e-poštom" sourceRef="Task_PoslatiDokumentaciju" targetRef="Participant_Kandidati" />
  </bpmn:collaboration>
  <bpmn:process id="Process_NISpVU" name="NISpVU – obrada prijava i rang-liste" isExecutable="false">
    <bpmn:documentation>Vanjski proces nacionalnog informacijskog sustava. Objava natječaja, zaprimanje prijava, generiranje rang-lista i dostava sveučilištima.</bpmn:documentation>
    <bpmn:startEvent id="Start_Natjecaj" name="Početak razdoblja upisa">
      <bpmn:timerEventDefinition id="TimerDef_28741">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2026-05-15T08:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Objaviti" name="Objaviti natječaj za upise" />
    <bpmn:serviceTask id="Task_ZaprimitiPrijave" name="Zaprimiti prijave kandidata putem portala" />
    <bpmn:intermediateCatchEvent id="Event_RokPrijave" name="Istekao rok za prijave">
      <bpmn:timerEventDefinition id="TimerDef_91141">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_PosebneOkolnosti" name="Posebne okolnosti?">
      <bpmn:documentation>Posebne okolnosti, npr. ponavljanje ispita iz mature. Upisi se odgađaju za određeni broj dana.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Generiranje" name="Spremno za generiranje?" />
    <bpmn:businessRuleTask id="Task_GeneriratiRang" name="Generirati rang-liste po studijskim programima" />
    <bpmn:sendTask id="Task_DostavitiRang" name="Dostaviti rang-liste sveučilištima" messageRef="Message_RangListe" />
    <bpmn:endEvent id="End_RangDostavljene" name="Rang-liste dostavljene" />
    <bpmn:intermediateCatchEvent id="Event_Odgoda" name="Odgoda upisa (7 dana)">
      <bpmn:timerEventDefinition id="TimerDef_51806">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="F_N1" sourceRef="Start_Natjecaj" targetRef="Task_Objaviti" />
    <bpmn:sequenceFlow id="F_N2" sourceRef="Task_Objaviti" targetRef="Task_ZaprimitiPrijave" />
    <bpmn:sequenceFlow id="F_N3" sourceRef="Task_ZaprimitiPrijave" targetRef="Event_RokPrijave" />
    <bpmn:sequenceFlow id="F_N4" sourceRef="Event_RokPrijave" targetRef="Gateway_PosebneOkolnosti" />
    <bpmn:sequenceFlow id="F_N5" name="Da" sourceRef="Gateway_PosebneOkolnosti" targetRef="Event_Odgoda" />
    <bpmn:sequenceFlow id="F_N7" name="Ne" sourceRef="Gateway_PosebneOkolnosti" targetRef="Gateway_Generiranje" />
    <bpmn:sequenceFlow id="F_N6" sourceRef="Event_Odgoda" targetRef="Gateway_Generiranje" />
    <bpmn:sequenceFlow id="F_N8" sourceRef="Gateway_Generiranje" targetRef="Task_GeneriratiRang" />
    <bpmn:sequenceFlow id="F_N9" sourceRef="Task_GeneriratiRang" targetRef="Task_DostavitiRang" />
    <bpmn:sequenceFlow id="F_N10" sourceRef="Task_DostavitiRang" targetRef="End_RangDostavljene" />
  </bpmn:process>
  <bpmn:process id="Process_Upis" name="Upis studenata na Sveučilište" isExecutable="false">
    <bpmn:documentation>Interni proces Sveučilišta od zaprimanja rang-lista do završetka jesenskog upisnog roka. Sve radnje provodi Ured za studente i upise, osim rješavanja složenih žalbi koje uključuje Pravnu službu.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Upis">
      <bpmn:lane id="Lane_Pravna" name="Pravna služba">
        <bpmn:flowNodeRef>Task_PravnaOdluka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ured" name="Ured za studente i upise">
        <bpmn:flowNodeRef>Start_RangListe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DokZaprimljena</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvjeritiDok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DokIspravna</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DokSpremna</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvjeritiDorada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZaprimitiIspravljenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluacija</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KonacneRang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObavijestitiKandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RokZalbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ZalbeObrada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RazmotritiZalbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ImaZalbi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RijesitiZalbu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SlozenaZalba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OsnovanostZalbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ZalbaPrihvacena</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AzuriratiRang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ViseZalbi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SveZalbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObjavitiKonacne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PoslatiDokumentaciju</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Arhivirati</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_UpisZavrsen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AltEvaluacija</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_RangListe" name="Rang-liste zaprimljene">
      <bpmn:messageEventDefinition id="MsgDef_Message_RangListe" messageRef="Message_RangListe" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_DokZaprimljena" name="Dokumentacija zaprimljena?" />
    <bpmn:manualTask id="Task_ProvjeritiDok" name="Provjeriti dostavljenu dokumentaciju" />
    <bpmn:exclusiveGateway id="Gateway_DokIspravna" name="Dokumentacija ispravna?" />
    <bpmn:exclusiveGateway id="Gateway_DokSpremna" name="Dokumentacija spremna?" />
    <bpmn:sendTask id="Task_ProvjeritiDorada" name="Poslati dokumentaciju na doradu" messageRef="Message_ZahtjevDorada" />
    <bpmn:receiveTask id="Task_ZaprimitiIspravljenu" name="Zaprimiti ispravljenu dokumentaciju" messageRef="Message_IspravljenaDok" />
    <bpmn:userTask id="Task_Evaluacija" name="Provesti internu evaluaciju kandidata (prijamni ispiti, intervjui)">
      <bpmn:documentation>Interna evaluacija prema rezultatima kandidata i vlastitim kriterijima; može uključivati prijamne ispite i intervjue.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_KonacneRang" name="Generirati konačne rang-liste" />
    <bpmn:sendTask id="Task_ObavijestitiKandidate" name="Obavijestiti kandidate o konačnim rang-listama" messageRef="Message_ObavijestKandidati" />
    <bpmn:intermediateCatchEvent id="Event_RokZalbe" name="Istekao rok za žalbe">
      <bpmn:timerEventDefinition id="TimerDef_1865">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ZalbeObrada" name="Žalbe za obradu?" />
    <bpmn:userTask id="Task_RazmotritiZalbe" name="Razmotriti pristigle žalbe" />
    <bpmn:exclusiveGateway id="Gateway_ImaZalbi" name="Ima li žalbi?" />
    <bpmn:userTask id="Task_RijesitiZalbu" name="Riješiti pojedinačnu žalbu" />
    <bpmn:exclusiveGateway id="Gateway_SlozenaZalba" name="Složena žalba?" />
    <bpmn:userTask id="Task_OsnovanostZalbe" name="Odlučiti o osnovanosti žalbe" />
    <bpmn:exclusiveGateway id="Gateway_ZalbaPrihvacena" name="Žalba prihvaćena?" />
    <bpmn:serviceTask id="Task_AzuriratiRang" name="Ažurirati konačne rang-liste" />
    <bpmn:exclusiveGateway id="Gateway_ViseZalbi" name="Ima više žalbi?" />
    <bpmn:exclusiveGateway id="Gateway_SveZalbe" name="Sve žalbe riješene?" />
    <bpmn:serviceTask id="Task_ObjavitiKonacne" name="Objaviti konačne rang-liste" />
    <bpmn:userTask id="Task_Upis" name="Provesti upis studenata putem interne aplikacije">
      <bpmn:documentation>Upis se provodi putem interne aplikacije sveučilišta; sve radnje provodi Ured za studente i upise.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_PoslatiDokumentaciju" name="Poslati dokumentaciju studentima e-poštom" messageRef="Message_DokumentacijaEmail">
      <bpmn:documentation>Nastala dokumentacija šalje se studentima e-poštom i arhivira u internom sustavu sveučilišta.</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_Arhivirati" name="Arhivirati dokumentaciju u internom sustavu" />
    <bpmn:endEvent id="End_UpisZavrsen" name="Jesenski upisni rok završen" />
    <bpmn:userTask id="Task_AltEvaluacija" name="Provesti ponovno bodovanje / alternativnu evaluaciju" />
    <bpmn:userTask id="Task_PravnaOdluka" name="Odlučiti o ponovnom bodovanju ili primjerenoj evaluacijskoj metodi">
      <bpmn:documentation>Složene žalbe, npr. one vezane uz bodovanje na prijamnom ispitu. Pravna služba može odrediti ponovno bodovanje ili drugu prikladnu evaluacijsku metodu (npr. intervju prilagođen kandidatu s invaliditetom).</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_U1" sourceRef="Start_RangListe" targetRef="Gateway_DokZaprimljena" />
    <bpmn:sequenceFlow id="F_U2" sourceRef="Gateway_DokZaprimljena" targetRef="Task_ProvjeritiDok" />
    <bpmn:sequenceFlow id="F_U3" sourceRef="Task_ProvjeritiDok" targetRef="Gateway_DokIspravna" />
    <bpmn:sequenceFlow id="F_U4" name="Da" sourceRef="Gateway_DokIspravna" targetRef="Gateway_DokSpremna" />
    <bpmn:sequenceFlow id="F_U5" name="Ne" sourceRef="Gateway_DokIspravna" targetRef="Task_ProvjeritiDorada" />
    <bpmn:sequenceFlow id="F_U7" sourceRef="Task_ZaprimitiIspravljenu" targetRef="Gateway_DokSpremna" />
    <bpmn:sequenceFlow id="F_U8" sourceRef="Gateway_DokSpremna" targetRef="Task_Evaluacija" />
    <bpmn:sequenceFlow id="F_U6" sourceRef="Task_ProvjeritiDorada" targetRef="Task_ZaprimitiIspravljenu" />
    <bpmn:sequenceFlow id="F_U9" sourceRef="Task_Evaluacija" targetRef="Task_KonacneRang" />
    <bpmn:sequenceFlow id="F_U10" sourceRef="Task_KonacneRang" targetRef="Task_ObavijestitiKandidate" />
    <bpmn:sequenceFlow id="F_U11" sourceRef="Task_ObavijestitiKandidate" targetRef="Event_RokZalbe" />
    <bpmn:sequenceFlow id="F_U12" sourceRef="Event_RokZalbe" targetRef="Gateway_ZalbeObrada" />
    <bpmn:sequenceFlow id="F_U26" name="Da" sourceRef="Gateway_ViseZalbi" targetRef="Gateway_ZalbeObrada" />
    <bpmn:sequenceFlow id="F_U13" sourceRef="Gateway_ZalbeObrada" targetRef="Task_RazmotritiZalbe" />
    <bpmn:sequenceFlow id="F_U14" sourceRef="Task_RazmotritiZalbe" targetRef="Gateway_ImaZalbi" />
    <bpmn:sequenceFlow id="F_U15" name="Da" sourceRef="Gateway_ImaZalbi" targetRef="Task_RijesitiZalbu" />
    <bpmn:sequenceFlow id="F_U16" name="Ne" sourceRef="Gateway_ImaZalbi" targetRef="Gateway_SveZalbe" />
    <bpmn:sequenceFlow id="F_U17" sourceRef="Task_RijesitiZalbu" targetRef="Gateway_SlozenaZalba" />
    <bpmn:sequenceFlow id="F_U18" name="Ne" sourceRef="Gateway_SlozenaZalba" targetRef="Task_OsnovanostZalbe" />
    <bpmn:sequenceFlow id="F_U19" name="Da" sourceRef="Gateway_SlozenaZalba" targetRef="Task_PravnaOdluka" />
    <bpmn:sequenceFlow id="F_U22" sourceRef="Task_OsnovanostZalbe" targetRef="Gateway_ZalbaPrihvacena" />
    <bpmn:sequenceFlow id="F_U21" sourceRef="Task_AltEvaluacija" targetRef="Gateway_ZalbaPrihvacena" />
    <bpmn:sequenceFlow id="F_U23" name="Da" sourceRef="Gateway_ZalbaPrihvacena" targetRef="Task_AzuriratiRang" />
    <bpmn:sequenceFlow id="F_U24" name="Ne" sourceRef="Gateway_ZalbaPrihvacena" targetRef="Gateway_ViseZalbi" />
    <bpmn:sequenceFlow id="F_U25" sourceRef="Task_AzuriratiRang" targetRef="Gateway_ViseZalbi" />
    <bpmn:sequenceFlow id="F_U27" name="Ne" sourceRef="Gateway_ViseZalbi" targetRef="Gateway_SveZalbe" />
    <bpmn:sequenceFlow id="F_U28" sourceRef="Gateway_SveZalbe" targetRef="Task_ObjavitiKonacne" />
    <bpmn:sequenceFlow id="F_U29" sourceRef="Task_ObjavitiKonacne" targetRef="Task_Upis" />
    <bpmn:sequenceFlow id="F_U30" sourceRef="Task_Upis" targetRef="Task_PoslatiDokumentaciju" />
    <bpmn:sequenceFlow id="F_U31" sourceRef="Task_PoslatiDokumentaciju" targetRef="Task_Arhivirati" />
    <bpmn:sequenceFlow id="F_U32" sourceRef="Task_Arhivirati" targetRef="End_UpisZavrsen" />
    <bpmn:sequenceFlow id="F_U20" sourceRef="Task_PravnaOdluka" targetRef="Task_AltEvaluacija" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Upis">
    <bpmndi:BPMNPlane id="BPMNPlane_Upis" bpmnElement="Collaboration_Upis">
      <bpmndi:BPMNShape id="Participant_NISpVU_di" bpmnElement="Participant_NISpVU" isHorizontal="true">
