<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_UPPTech" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_UPPTech" name="UPPTech" processRef="Process_UPPTech" />
    <bpmn:participant id="Participant_CrazyTech" name="CrazyTech" processRef="Process_CrazyTech" />
    <bpmn:messageFlow id="MF_Upit" name="Upit za ponudu" sourceRef="P_Upit" targetRef="C_StartUpit" />
    <bpmn:messageFlow id="MF_Ponuda" name="Ponuda" sourceRef="C_Ponuda" targetRef="P_Ponuda" />
    <bpmn:messageFlow id="MF_Potvrda" name="Potvrda o prihvaćanju" sourceRef="P_Potvrda" targetRef="C_StartPotvrda" />
    <bpmn:messageFlow id="MF_Softver" name="Softversko rješenje" sourceRef="C_Predati" targetRef="P_Softver" />
  </bpmn:collaboration>
  <bpmn:process id="Process_UPPTech" name="UPPTech" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_UPPTech">
      <bpmn:lane id="Lane_Management" name="Menadžerski tim">
        <bpmn:flowNodeRef>P_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Kupnja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Ponuda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Razmotriti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_GPrihvacena</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_EndOdbijena</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Potvrda</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT tim">
        <bpmn:flowNodeRef>P_Provjeriti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_GPostoji</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Instalirati</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_EndKupljen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Upit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Softver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Postaviti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_EndImpl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P_Start" name="Ustanovljena potreba za novim softverom">
      <bpmn:outgoing>F_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P_Provjeriti" name="Provjeriti dostupan softver na tržištu">
      <bpmn:incoming>F_P1</bpmn:incoming>
      <bpmn:outgoing>F_P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P_GPostoji" name="Postoji odgovarajuće rješenje?">
      <bpmn:incoming>F_P2</bpmn:incoming>
      <bpmn:outgoing>F_P3</bpmn:outgoing>
      <bpmn:outgoing>F_P6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P_Kupnja" name="Dogovoriti kupnju softvera">
      <bpmn:incoming>F_P3</bpmn:incoming>
      <bpmn:outgoing>F_P4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P_Instalirati" name="Instalirati softver na server">
      <bpmn:incoming>F_P4</bpmn:incoming>
      <bpmn:outgoing>F_P5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P_EndKupljen" name="Softver kupljen i instaliran">
      <bpmn:incoming>F_P5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="P_Upit" name="Zatražiti ponudu za razvoj softvera" messageRef="Msg_Upit">
      <bpmn:documentation>IT tim odlučuje povjeriti razvoj vanjskoj tvrtki CrazyTech i šalje upit e-poštom.</bpmn:documentation>
      <bpmn:incoming>F_P6</bpmn:incoming>
      <bpmn:outgoing>F_P7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="P_Ponuda" name="Zaprimiti ponudu" messageRef="Msg_Ponuda">
      <bpmn:incoming>F_P7</bpmn:incoming>
      <bpmn:outgoing>F_P8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="P_Razmotriti" name="Razmotriti ponudu">
      <bpmn:incoming>F_P8</bpmn:incoming>
      <bpmn:outgoing>F_P9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P_GPrihvacena" name="Ponuda prihvaćena?">
      <bpmn:incoming>F_P9</bpmn:incoming>
      <bpmn:outgoing>F_P10</bpmn:outgoing>
      <bpmn:outgoing>F_P11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P_EndOdbijena" name="Ponuda odbijena">
      <bpmn:incoming>F_P10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="P_Potvrda" name="Poslati potvrdu o prihvaćanju ponude" messageRef="Msg_Potvrda">
      <bpmn:incoming>F_P11</bpmn:incoming>
      <bpmn:outgoing>F_P12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="P_Softver" name="Zaprimiti razvijeni softver" messageRef="Msg_Softver">
      <bpmn:incoming>F_P12</bpmn:incoming>
      <bpmn:outgoing>F_P13</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="P_Postaviti" name="Postaviti softver na server">
      <bpmn:incoming>F_P13</bpmn:incoming>
      <bpmn:outgoing>F_P14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P_EndImpl" name="Softver implementiran">
      <bpmn:incoming>F_P14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_P1" sourceRef="P_Start" targetRef="P_Provjeriti" />
    <bpmn:sequenceFlow id="F_P2" sourceRef="P_Provjeriti" targetRef="P_GPostoji" />
    <bpmn:sequenceFlow id="F_P3" name="Da" sourceRef="P_GPostoji" targetRef="P_Kupnja" />
    <bpmn:sequenceFlow id="F_P4" sourceRef="P_Kupnja" targetRef="P_Instalirati" />
    <bpmn:sequenceFlow id="F_P5" sourceRef="P_Instalirati" targetRef="P_EndKupljen" />
    <bpmn:sequenceFlow id="F_P6" name="Ne" sourceRef="P_GPostoji" targetRef="P_Upit" />
    <bpmn:sequenceFlow id="F_P7" sourceRef="P_Upit" targetRef="P_Ponuda" />
    <bpmn:sequenceFlow id="F_P8" sourceRef="P_Ponuda" targetRef="P_Razmotriti" />
    <bpmn:sequenceFlow id="F_P9" sourceRef="P_Razmotriti" targetRef="P_GPrihvacena" />
    <bpmn:sequenceFlow id="F_P10" name="Ne" sourceRef="P_GPrihvacena" targetRef="P_EndOdbijena" />
    <bpmn:sequenceFlow id="F_P11" name="Da" sourceRef="P_GPrihvacena" targetRef="P_Potvrda" />
    <bpmn:sequenceFlow id="F_P12" sourceRef="P_Potvrda" targetRef="P_Softver" />
    <bpmn:sequenceFlow id="F_P13" sourceRef="P_Softver" targetRef="P_Postaviti" />
    <bpmn:sequenceFlow id="F_P14" sourceRef="P_Postaviti" targetRef="P_EndImpl" />
  </bpmn:process>
  <bpmn:process id="Process_CrazyTech" name="CrazyTech" isExecutable="true">
    <bpmn:startEvent id="C_StartUpit" name="Upit za ponudu zaprimljen">
      <bpmn:outgoing>F_C1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_StartUpit_def" messageRef="Msg_Upit" />
    </bpmn:startEvent>
    <bpmn:userTask id="C_Procijeniti" name="Procijeniti troškove razvoja">
      <bpmn:incoming>F_C1</bpmn:incoming>
      <bpmn:outgoing>F_C2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="C_Ponuda" name="Poslati ponudu" messageRef="Msg_Ponuda">
      <bpmn:incoming>F_C2</bpmn:incoming>
      <bpmn:outgoing>F_C3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="C_EndPonuda" name="Ponuda poslana">
      <bpmn:incoming>F_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="C_StartPotvrda" name="Potvrda o prihvaćanju zaprimljena">
      <bpmn:outgoing>F_C4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_StartPotvrda_def" messageRef="Msg_Potvrda" />
    </bpmn:startEvent>
    <bpmn:subProcess id="C_Sub" name="Razviti softversko rješenje">
      <bpmn:documentation>Definiranje zahtjeva, dizajn, razvoj i testiranje. Ako testiranje ne prođe, vraća se na razvoj.</bpmn:documentation>
      <bpmn:incoming>F_C4</bpmn:incoming>
      <bpmn:outgoing>F_C5</bpmn:outgoing>
      <bpmn:startEvent id="S_Start" name="Razvoj započet">
        <bpmn:outgoing>F_S1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="S_Zahtjevi" name="Definirati zahtjeve">
        <bpmn:incoming>F_S1</bpmn:incoming>
        <bpmn:outgoing>F_S2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="S_Dizajn" name="Dizajnirati softver">
        <bpmn:incoming>F_S2</bpmn:incoming>
        <bpmn:outgoing>F_S3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="S_M">
        <bpmn:incoming>F_S3</bpmn:incoming>
        <bpmn:incoming>F_S8</bpmn:incoming>
        <bpmn:outgoing>F_S4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="S_Razviti" name="Razviti softver">
        <bpmn:incoming>F_S4</bpmn:incoming>
        <bpmn:outgoing>F_S5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="S_Testirati" name="Testirati softver">
        <bpmn:incoming>F_S5</bpmn:incoming>
        <bpmn:outgoing>F_S6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="S_G" name="Testiranje uspješno?">
        <bpmn:incoming>F_S6</bpmn:incoming>
        <bpmn:outgoing>F_S7</bpmn:outgoing>
        <bpmn:outgoing>F_S8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="S_End" name="Softver razvijen">
        <bpmn:incoming>F_S7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F_S1" sourceRef="S_Start" targetRef="S_Zahtjevi" />
      <bpmn:sequenceFlow id="F_S2" sourceRef="S_Zahtjevi" targetRef="S_Dizajn" />
      <bpmn:sequenceFlow id="F_S3" sourceRef="S_Dizajn" targetRef="S_M" />
      <bpmn:sequenceFlow id="F_S4" sourceRef="S_M" targetRef="S_Razviti" />
      <bpmn:sequenceFlow id="F_S5" sourceRef="S_Razviti" targetRef="S_Testirati" />
      <bpmn:sequenceFlow id="F_S6" sourceRef="S_Testirati" targetRef="S_G" />
      <bpmn:sequenceFlow id="F_S7" name="Da" sourceRef="S_G" targetRef="S_End" />
      <bpmn:sequenceFlow id="F_S8" name="Ne" sourceRef="S_G" targetRef="S_M" />
    </bpmn:subProcess>
    <bpmn:sendTask id="C_Predati" name="Predati softver" messageRef="Msg_Softver">
      <bpmn:incoming>F_C5</bpmn:incoming>
      <bpmn:outgoing>F_C6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="C_EndRazvoj" name="Softver predan">
      <bpmn:incoming>F_C6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_C1" sourceRef="C_StartUpit" targetRef="C_Procijeniti" />
    <bpmn:sequenceFlow id="F_C2" sourceRef="C_Procijeniti" targetRef="C_Ponuda" />
