<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_UpisStudenata" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_NISpVU" name="NISpVU (Postani student)" processRef="Process_NISpVU" />
    <bpmn:participant id="Participant_Sveuciliste" name="Sveučilište Jurja Dobrile u Puli" processRef="Process_Upis" />
    <bpmn:participant id="Participant_Kandidati" name="Kandidati" />
    <bpmn:messageFlow id="MF_Rang" name="Rang-liste kandidata" sourceRef="N_Dostaviti" targetRef="U_Start" />
    <bpmn:messageFlow id="MF_Dorada" name="Dokumentacija za doradu" sourceRef="U_Dorada" targetRef="Participant_NISpVU" />
    <bpmn:messageFlow id="MF_Ispravljena" name="Ispravljena dokumentacija" sourceRef="Participant_NISpVU" targetRef="U_Ispravljena" />
    <bpmn:messageFlow id="MF_Obavijest" name="Obavijest o konačnim rang-listama" sourceRef="U_Obavijestiti" targetRef="Participant_Kandidati" />
    <bpmn:messageFlow id="MF_Dokumentacija" name="Dokumentacija o upisu" sourceRef="U_Dokumentacija" targetRef="Participant_Kandidati" />
  </bpmn:collaboration>
  <bpmn:process id="Process_NISpVU" name="NISpVU (Postani student)" isExecutable="true">
    <bpmn:startEvent id="N_Start" name="Početak upisnog razdoblja">
      <bpmn:outgoing>F_N1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="N_Start_def">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2027-05-15T08:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="N_Objaviti" name="Objaviti natječaj za upise">
      <bpmn:incoming>F_N1</bpmn:incoming>
      <bpmn:outgoing>F_N2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N_Prijave" name="Zaprimati prijave kandidata">
      <bpmn:documentation>Kandidati online prijavljuju odabir studija putem sustava Postani student.</bpmn:documentation>
      <bpmn:incoming>F_N2</bpmn:incoming>
      <bpmn:outgoing>F_N3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="N_RokPrijave" name="Istekao rok za prijave">
      <bpmn:incoming>F_N3</bpmn:incoming>
      <bpmn:outgoing>F_N4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="N_RokPrijave_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="N_GOkolnosti" name="Posebne okolnosti?">
      <bpmn:documentation>Npr. ponavljanje ispita iz pojedinog predmeta na državnoj maturi.</bpmn:documentation>
      <bpmn:incoming>F_N4</bpmn:incoming>
      <bpmn:outgoing>F_N5</bpmn:outgoing>
      <bpmn:outgoing>F_N6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="N_Odgoda" name="Istekla odgoda upisa">
      <bpmn:incoming>F_N5</bpmn:incoming>
      <bpmn:outgoing>F_N7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="N_Odgoda_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="N_Merge">
      <bpmn:incoming>F_N6</bpmn:incoming>
      <bpmn:incoming>F_N7</bpmn:incoming>
      <bpmn:outgoing>F_N8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="N_Generirati" name="Generirati rang-liste po studijskim programima">
      <bpmn:incoming>F_N8</bpmn:incoming>
      <bpmn:outgoing>F_N9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="N_Dostaviti" name="Dostaviti rang-liste sveučilištima" messageRef="Msg_Rang">
      <bpmn:incoming>F_N9</bpmn:incoming>
      <bpmn:outgoing>F_N10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="N_End" name="Rang-liste dostavljene">
      <bpmn:incoming>F_N10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_N1" sourceRef="N_Start" targetRef="N_Objaviti" />
    <bpmn:sequenceFlow id="F_N2" sourceRef="N_Objaviti" targetRef="N_Prijave" />
    <bpmn:sequenceFlow id="F_N3" sourceRef="N_Prijave" targetRef="N_RokPrijave" />
    <bpmn:sequenceFlow id="F_N4" sourceRef="N_RokPrijave" targetRef="N_GOkolnosti" />
    <bpmn:sequenceFlow id="F_N5" name="Da" sourceRef="N_GOkolnosti" targetRef="N_Odgoda" />
    <bpmn:sequenceFlow id="F_N6" name="Ne" sourceRef="N_GOkolnosti" targetRef="N_Merge" />
    <bpmn:sequenceFlow id="F_N7" sourceRef="N_Odgoda" targetRef="N_Merge" />
    <bpmn:sequenceFlow id="F_N8" sourceRef="N_Merge" targetRef="N_Generirati" />
    <bpmn:sequenceFlow id="F_N9" sourceRef="N_Generirati" targetRef="N_Dostaviti" />
    <bpmn:sequenceFlow id="F_N10" sourceRef="N_Dostaviti" targetRef="N_End" />
  </bpmn:process>
  <bpmn:process id="Process_Upis" name="Sveučilište Jurja Dobrile u Puli" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_Upis">
      <bpmn:lane id="Lane_Ured" name="Ured za studente i upise">
        <bpmn:flowNodeRef>U_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Provjeriti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_GIspravna</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Dorada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Ispravljena</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_M0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Evaluacija</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Konacne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Obavijestiti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_RokZalbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Razmotriti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Odluciti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Ponovno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Azurirati</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Objaviti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Upis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Dokumentacija</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Arhivirati</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_RokUpisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pravna" name="Pravna služba">
        <bpmn:flowNodeRef>U_Pravna</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="U_Start" name="Rang-liste zaprimljene">
      <bpmn:outgoing>F_U1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="U_Start_def" messageRef="Msg_Rang" />
    </bpmn:startEvent>
    <bpmn:manualTask id="U_Provjeriti" name="Provjeriti dostavljenu dokumentaciju">
      <bpmn:incoming>F_U1</bpmn:incoming>
      <bpmn:outgoing>F_U2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="U_GIspravna" name="Dokumentacija ispravna?">
      <bpmn:incoming>F_U2</bpmn:incoming>
      <bpmn:outgoing>F_U3</bpmn:outgoing>
      <bpmn:outgoing>F_U4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="U_Dorada" name="Poslati dokumentaciju na doradu" messageRef="Msg_Dorada">
      <bpmn:documentation>NISpVU se obavještava o nedostacima, a problematična dokumentacija šalje se na doradu.</bpmn:documentation>
      <bpmn:incoming>F_U3</bpmn:incoming>
      <bpmn:outgoing>F_U5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="U_Ispravljena" name="Zaprimiti ispravljenu dokumentaciju" messageRef="Msg_Ispravljena">
      <bpmn:incoming>F_U5</bpmn:incoming>
      <bpmn:outgoing>F_U6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="U_M0">
      <bpmn:incoming>F_U4</bpmn:incoming>
      <bpmn:incoming>F_U6</bpmn:incoming>
      <bpmn:outgoing>F_U7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_Evaluacija" name="Provesti internu evaluaciju kandidata">
      <bpmn:documentation>Evaluacija prema rezultatima i vlastitim kriterijima (prijamni ispiti, intervjui i sl.).</bpmn:documentation>
      <bpmn:incoming>F_U7</bpmn:incoming>
      <bpmn:outgoing>F_U8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="U_Konacne" name="Generirati konačne rang-liste">
      <bpmn:incoming>F_U8</bpmn:incoming>
      <bpmn:outgoing>F_U9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="U_Obavijestiti" name="Obavijestiti kandidate o konačnim rang-listama" messageRef="Msg_Obavijest">
      <bpmn:incoming>F_U9</bpmn:incoming>
      <bpmn:outgoing>F_U10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="U_RokZalbe" name="Istekao rok za žalbe">
      <bpmn:incoming>F_U10</bpmn:incoming>
      <bpmn:outgoing>F_U11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="U_RokZalbe_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P8D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="U_G1" name="Ima li žalbi?">
      <bpmn:incoming>F_U11</bpmn:incoming>
      <bpmn:outgoing>F_U12</bpmn:outgoing>
      <bpmn:outgoing>F_U13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U_M1">
      <bpmn:incoming>F_U12</bpmn:incoming>
      <bpmn:incoming>F_U26</bpmn:incoming>
      <bpmn:outgoing>F_U14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_Razmotriti" name="Razmotriti žalbu">
      <bpmn:incoming>F_U14</bpmn:incoming>
      <bpmn:outgoing>F_U15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U_G2" name="Složena žalba?">
      <bpmn:documentation>Npr. žalbe vezane uz bodovanje na prijamnom ispitu.</bpmn:documentation>
      <bpmn:incoming>F_U15</bpmn:incoming>
      <bpmn:outgoing>F_U16</bpmn:outgoing>
      <bpmn:outgoing>F_U17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_Odluciti" name="Odlučiti o žalbi">
      <bpmn:incoming>F_U16</bpmn:incoming>
      <bpmn:outgoing>F_U20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U_Pravna" name="Odrediti ponovno bodovanje ili drugu metodu evaluacije">
      <bpmn:documentation>Npr. intervju nije prikladan za kandidata s invaliditetom pa se određuje druga metoda.</bpmn:documentation>
      <bpmn:incoming>F_U17</bpmn:incoming>
      <bpmn:outgoing>F_U18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U_Ponovno" name="Provesti ponovnu evaluaciju">
      <bpmn:incoming>F_U18</bpmn:incoming>
      <bpmn:outgoing>F_U19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U_M2">
      <bpmn:incoming>F_U19</bpmn:incoming>
      <bpmn:incoming>F_U20</bpmn:incoming>
      <bpmn:outgoing>F_U21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U_G3" name="Žalba prihvaćena?">
      <bpmn:incoming>F_U21</bpmn:incoming>
      <bpmn:outgoing>F_U22</bpmn:outgoing>
      <bpmn:outgoing>F_U23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U_Azurirati" name="Ažurirati konačne rang-liste">
      <bpmn:incoming>F_U22</bpmn:incoming>
      <bpmn:outgoing>F_U24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="U_M3">
      <bpmn:incoming>F_U23</bpmn:incoming>
      <bpmn:incoming>F_U24</bpmn:incoming>
      <bpmn:outgoing>F_U25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U_G4" name="Ima još žalbi?">
      <bpmn:incoming>F_U25</bpmn:incoming>
      <bpmn:outgoing>F_U26</bpmn:outgoing>
      <bpmn:outgoing>F_U27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U_M4">
      <bpmn:incoming>F_U13</bpmn:incoming>
      <bpmn:incoming>F_U27</bpmn:incoming>
      <bpmn:outgoing>F_U28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="U_Objaviti" name="Objaviti konačne rang-liste">
      <bpmn:incoming>F_U28</bpmn:incoming>
      <bpmn:outgoing>F_U29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U_Upis" name="Provesti upis studenata u internoj aplikaciji">
      <bpmn:incoming>F_U29</bpmn:incoming>
      <bpmn:outgoing>F_U30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="U_Dokumentacija" name="Poslati dokumentaciju studentima e-poštom" messageRef="Msg_Dokumentacija">
      <bpmn:incoming>F_U30</bpmn:incoming>
      <bpmn:outgoing>F_U31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="U_Arhivirati" name="Arhivirati dokumentaciju u internom sustavu">
      <bpmn:incoming>F_U31</bpmn:incoming>
      <bpmn:outgoing>F_U32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="U_RokUpisa" name="Završio jesenski upisni rok">
      <bpmn:incoming>F_U32</bpmn:incoming>
      <bpmn:outgoing>F_U33</bpmn:outgoing>
      <bpmn:timerEventDefinition id="U_RokUpisa_def">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2027-09-30T16:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="U_End" name="Upis završen">
      <bpmn:incoming>F_U33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_U1" sourceRef="U_Start" targetRef="U_Provjeriti" />
