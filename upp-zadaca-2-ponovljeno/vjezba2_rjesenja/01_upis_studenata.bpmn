  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_NISpVU_di" bpmnElement="Participant_NISpVU" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="2050" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Start_di" bpmnElement="N_Start">
        <dc:Bounds x="212" y="167" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195" y="210" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Objaviti_di" bpmnElement="N_Objaviti">
        <dc:Bounds x="300" y="145" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Prijave_di" bpmnElement="N_Prijave">
        <dc:Bounds x="500" y="145" width="150" height="80" />
      </bpmndi:BPMNShape>
