  <bpmn:process id="Process_4" name="Izrada personalizirane web stranice" isExecutable="false">
    <bpmn:documentation>Proces izrade web stranice s dvije iterativne petlje (dizajn i testiranje).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_4">
      <bpmn:lane id="Lane_4_1" name="Klijent">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
