      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_1" name="Dizajn odobren?" gatewayDirection="Diverging">
