<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Monri" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_Monri">
    <bpmn:participant id="Participant_Ugostitelj" name="Ugostitelj" />
    <bpmn:participant id="Participant_Monri" name="Monri Payments – uvođenje blagajničkog sustava" processRef="Process_Monri" />
    <bpmn:messageFlow id="MF_Zahtjev" name="Zahtjev" sourceRef="Participant_Ugostitelj" targetRef="Start_Zahtjev" />
    <bpmn:messageFlow id="MF_Ponuda" name="Ponuda" sourceRef="Task_PoslatiPonudu" targetRef="Participant_Ugostitelj" />
    <bpmn:messageFlow id="MF_Odgovor" name="Odgovor na ponudu" sourceRef="Participant_Ugostitelj" targetRef="Task_ZaprimitiOdgovor" />
    <bpmn:messageFlow id="MF_Ugovor" name="Ugovor" sourceRef="Task_Ugovor" targetRef="Participant_Ugostitelj" />
    <bpmn:messageFlow id="MF_Cjenik" name="Cjenik, certifikat" sourceRef="Participant_Ugostitelj" targetRef="Task_ZaprimitiCjenik" />
    <bpmn:messageFlow id="MF_Termin" name="Termin instalacije" sourceRef="Task_Termin" targetRef="Participant_Ugostitelj" />
    <bpmn:messageFlow id="MF_Potvrda" name="Potvrda i račun" sourceRef="End_PustenoURad" targetRef="Participant_Ugostitelj" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Monri" name="Uvođenje blagajničkog sustava za ugostitelje" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Monri">
      <bpmn:lane id="Lane_Prodaja" name="Prodaja">
        <bpmn:flowNodeRef>Start_Zahtjev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Analiza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergePonuda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IzraditiPonudu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PoslatiPonudu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZaprimitiOdgovor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Odgovor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Odbijena</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ugovor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tehnika" name="Tehnička podrška">
        <bpmn:flowNodeRef>Gw_AndSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZaprimitiCjenik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnijetiCjenik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PripremitiUredaje</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AndJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Termin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Termin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Instalacija</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Edukacija</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Probni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PustenoURad</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Zahtjev" name="Zahtjev zaprimljen">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Zahtjev" messageRef="Message_Zahtjev" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Analiza" name="Analizirati potrebe">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:startEvent id="A_Start" name="Početak analize">
        <bpmn:outgoing>AF1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A_Objekt" name="Prikupiti podatke o objektu">
        <bpmn:incoming>AF1</bpmn:incoming>
        <bpmn:outgoing>AF2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="A_Poslovanje" name="Prikupiti podatke o poslovanju">
        <bpmn:incoming>AF2</bpmn:incoming>
        <bpmn:outgoing>AF3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A_Vrsta" name="Vrsta objekta?">
        <bpmn:incoming>AF3</bpmn:incoming>
        <bpmn:outgoing>AF4</bpmn:outgoing>
        <bpmn:outgoing>AF5</bpmn:outgoing>
        <bpmn:outgoing>AF6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A_Start_" name="Predložiti Remaris Start">
        <bpmn:incoming>AF4</bpmn:incoming>
        <bpmn:outgoing>AF7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="A_X" name="Predložiti Remaris X">
        <bpmn:incoming>AF5</bpmn:incoming>
        <bpmn:outgoing>AF8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="A_Master" name="Predložiti Remaris Master">
        <bpmn:incoming>AF6</bpmn:incoming>
        <bpmn:outgoing>AF9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A_Merge">
        <bpmn:incoming>AF7</bpmn:incoming>
        <bpmn:incoming>AF8</bpmn:incoming>
        <bpmn:incoming>AF9</bpmn:incoming>
        <bpmn:outgoing>AF10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A_End" name="Sustav predložen">
        <bpmn:incoming>AF10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="AF1" sourceRef="A_Start" targetRef="A_Objekt" />
      <bpmn:sequenceFlow id="AF2" sourceRef="A_Objekt" targetRef="A_Poslovanje" />
      <bpmn:sequenceFlow id="AF3" sourceRef="A_Poslovanje" targetRef="A_Vrsta" />
      <bpmn:sequenceFlow id="AF4" name="Mobilni / sezonski" sourceRef="A_Vrsta" targetRef="A_Start_" />
      <bpmn:sequenceFlow id="AF5" name="Kafić / bar" sourceRef="A_Vrsta" targetRef="A_X" />
      <bpmn:sequenceFlow id="AF6" name="Restoran / hotel" sourceRef="A_Vrsta" targetRef="A_Master" />
      <bpmn:sequenceFlow id="AF7" sourceRef="A_Start_" targetRef="A_Merge" />
      <bpmn:sequenceFlow id="AF8" sourceRef="A_X" targetRef="A_Merge" />
      <bpmn:sequenceFlow id="AF9" sourceRef="A_Master" targetRef="A_Merge" />
      <bpmn:sequenceFlow id="AF10" sourceRef="A_Merge" targetRef="A_End" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_MergePonuda">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_IzraditiPonudu" name="Izraditi ponudu">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_PoslatiPonudu" name="Poslati ponudu">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ZaprimitiOdgovor" name="Zaprimiti odgovor na ponudu" messageRef="Message_Odgovor">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gw_Odgovor" name="Odgovor na ponudu?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Odbijena" name="Ponuda odbijena">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Ugovor" name="Sklopiti ugovor">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gw_AndSplit">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="Task_ZaprimitiCjenik" name="Zaprimiti cjenik i FINA certifikat" messageRef="Message_Cjenik">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_UnijetiCjenik" name="Unijeti cjenik i ovlaštenja">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_PripremitiUredaje" name="Pripremiti uređaje">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="Gw_AndJoin">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_Termin" name="Dogovoriti termin instalacije">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Timer_Termin" name="Termin instalacije">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_Termin">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">=terminInstalacije</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Sub_Instalacija" name="Instalirati i testirati sustav">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:startEvent id="I_Start" name="Početak instalacije">
        <bpmn:outgoing>IF1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="I_Postaviti" name="Dostaviti i postaviti uređaje">
        <bpmn:incoming>IF1</bpmn:incoming>
        <bpmn:outgoing>IF2</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:userTask id="I_Konfigurirati" name="Povezati blagajnu, POS i terminale">
        <bpmn:incoming>IF2</bpmn:incoming>
        <bpmn:outgoing>IF3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="I_Merge">
        <bpmn:incoming>IF3</bpmn:incoming>
        <bpmn:incoming>IF8</bpmn:incoming>
        <bpmn:outgoing>IF4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="I_Testirati" name="Provesti probnu naplatu">
        <bpmn:incoming>IF4</bpmn:incoming>
        <bpmn:outgoing>IF5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="I_Test" name="Test uspješan?">
        <bpmn:incoming>IF5</bpmn:incoming>
        <bpmn:outgoing>IF6</bpmn:outgoing>
        <bpmn:outgoing>IF7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="I_End" name="Sustav ispravan">
        <bpmn:incoming>IF6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="I_Otkloniti" name="Otkloniti greške">
        <bpmn:incoming>IF7</bpmn:incoming>
        <bpmn:outgoing>IF8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="IF1" sourceRef="I_Start" targetRef="I_Postaviti" />
      <bpmn:sequenceFlow id="IF2" sourceRef="I_Postaviti" targetRef="I_Konfigurirati" />
      <bpmn:sequenceFlow id="IF3" sourceRef="I_Konfigurirati" targetRef="I_Merge" />
      <bpmn:sequenceFlow id="IF4" sourceRef="I_Merge" targetRef="I_Testirati" />
      <bpmn:sequenceFlow id="IF5" sourceRef="I_Testirati" targetRef="I_Test" />
      <bpmn:sequenceFlow id="IF6" name="Da" sourceRef="I_Test" targetRef="I_End" />
      <bpmn:sequenceFlow id="IF7" name="Ne" sourceRef="I_Test" targetRef="I_Otkloniti" />
      <bpmn:sequenceFlow id="IF8" sourceRef="I_Otkloniti" targetRef="I_Merge" />
    </bpmn:subProcess>
    <bpmn:manualTask id="Task_Edukacija" name="Educirati osoblje">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Timer_Probni" name="Probni rad (7 dana)">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_Probni">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_PustenoURad" name="Sustav pušten u rad">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Sustav pušten u rad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_End_PustenoURad" messageRef="Message_Potvrda" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Zahtjev" targetRef="Sub_Analiza" />
    <bpmn:sequenceFlow id="F2" sourceRef="Sub_Analiza" targetRef="Gw_MergePonuda" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_MergePonuda" targetRef="Task_IzraditiPonudu" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_IzraditiPonudu" targetRef="Task_PoslatiPonudu" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_PoslatiPonudu" targetRef="Task_ZaprimitiOdgovor" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_ZaprimitiOdgovor" targetRef="Gw_Odgovor" />
    <bpmn:sequenceFlow id="F7" name="Prihvaćena" sourceRef="Gw_Odgovor" targetRef="Task_Ugovor" />
    <bpmn:sequenceFlow id="F8" name="Odbijena" sourceRef="Gw_Odgovor" targetRef="End_Odbijena" />
    <bpmn:sequenceFlow id="F9" name="Izmjena" sourceRef="Gw_Odgovor" targetRef="Gw_MergePonuda" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Ugovor" targetRef="Gw_AndSplit" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_AndSplit" targetRef="Task_ZaprimitiCjenik" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_ZaprimitiCjenik" targetRef="Task_UnijetiCjenik" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_AndSplit" targetRef="Task_PripremitiUredaje" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_UnijetiCjenik" targetRef="Gw_AndJoin" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_PripremitiUredaje" targetRef="Gw_AndJoin" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_AndJoin" targetRef="Task_Termin" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Termin" targetRef="Timer_Termin" />
    <bpmn:sequenceFlow id="F18" sourceRef="Timer_Termin" targetRef="Sub_Instalacija" />
    <bpmn:sequenceFlow id="F19" sourceRef="Sub_Instalacija" targetRef="Task_Edukacija" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Edukacija" targetRef="Timer_Probni" />
    <bpmn:sequenceFlow id="F21" sourceRef="Timer_Probni" targetRef="End_PustenoURad" />
  </bpmn:process>
  <bpmn:message id="Message_Zahtjev" name="Zahtjev za uvođenje sustava" />
  <bpmn:message id="Message_Odgovor" name="Odgovor na ponudu" />
  <bpmn:message id="Message_Cjenik" name="Cjenik i FINA certifikat" />
  <bpmn:message id="Message_Potvrda" name="Potvrda i račun" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Monri">
    <bpmndi:BPMNPlane id="BPMNPlane_Monri" bpmnElement="Collaboration_Monri">
      <bpmndi:BPMNShape id="Participant_Ugostitelj_di" bpmnElement="Participant_Ugostitelj" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="2290" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Monri_di" bpmnElement="Participant_Monri" isHorizontal="true">
        <dc:Bounds x="160" y="180" width="2290" height="470" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Tehnika_di" bpmnElement="Lane_Tehnika" isHorizontal="true">
        <dc:Bounds x="190" y="410" width="2260" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Prodaja_di" bpmnElement="Lane_Prodaja" isHorizontal="true">
        <dc:Bounds x="190" y="180" width="2260" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Zahtjev_di" bpmnElement="Start_Zahtjev">
        <dc:Bounds x="222" y="277" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="200" y="317" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Analiza_di" bpmnElement="Sub_Analiza" isExpanded="false">
        <dc:Bounds x="290" y="255" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_MergePonuda_di" bpmnElement="Gw_MergePonuda" isMarkerVisible="true">
        <dc:Bounds x="445" y="270" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IzraditiPonudu_di" bpmnElement="Task_IzraditiPonudu">
        <dc:Bounds x="530" y="255" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PoslatiPonudu_di" bpmnElement="Task_PoslatiPonudu">
        <dc:Bounds x="680" y="255" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ZaprimitiOdgovor_di" bpmnElement="Task_ZaprimitiOdgovor">
        <dc:Bounds x="830" y="255" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Odgovor_di" bpmnElement="Gw_Odgovor" isMarkerVisible="true">
        <dc:Bounds x="985" y="270" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1017" y="322" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Odbijena_di" bpmnElement="End_Odbijena">
        <dc:Bounds x="1077" y="207" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1050" y="190" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ugovor_di" bpmnElement="Task_Ugovor">
        <dc:Bounds x="1120" y="255" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_AndSplit_di" bpmnElement="Gw_AndSplit">
        <dc:Bounds x="1265" y="505" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ZaprimitiCjenik_di" bpmnElement="Task_ZaprimitiCjenik">
        <dc:Bounds x="1350" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UnijetiCjenik_di" bpmnElement="Task_UnijetiCjenik">
        <dc:Bounds x="1500" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PripremitiUredaje_di" bpmnElement="Task_PripremitiUredaje">
        <dc:Bounds x="1425" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_AndJoin_di" bpmnElement="Gw_AndJoin">
        <dc:Bounds x="1655" y="505" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Termin_di" bpmnElement="Task_Termin">
        <dc:Bounds x="1740" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_Termin_di" bpmnElement="Timer_Termin">
        <dc:Bounds x="1892" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1875" y="552" width="70" height="27" />
        </bpmndi:BPMNLabel>
